-- Automatic Fire deliberately does not change module.Auto. It repeats a
-- left-click through VirtualInputManager at the selected Fire Interval while
-- the original physical mouse button remains held. Keep this state separate
-- from the InputObject because a virtual button-up can change its state to End.
local physicalMouseHeld = false
local physicalHoldStartedAt = 0
local autoClickLoopRunning = false
local sendingVirtualClick = false
local virtualReleasePending = false
local rawMouseDown = false
local rawMouseStateAvailable = false
local rawMouseConnection = nil

-- Madium's ImGui input is fed by the physical Windows mouse and is not changed
-- by VirtualInputManager. Use it to distinguish a real hold/release from the
-- synthetic button-up events needed to produce repeated Roblox clicks.
local imguiApi = environment.ImGui
if type(imguiApi) == "table"
	and type(imguiApi.OnRender) == "function"
	and type(imguiApi.IsMouseDown) == "function" then
	pcall(function()
		rawMouseConnection = imguiApi.OnRender(function()
			rawMouseDown = imguiApi.IsMouseDown(
				environment.ImGuiMouseButton_Left or 0
			)
			rawMouseStateAvailable = true
		end)
	end)
end

local function getAutomaticFireInterval()
	return math.max(0.01, tonumber(options.FireInterval) or 0.3)
end

local function isPhysicalMouseHeld()
	if not physicalMouseHeld then
		return false
	end
	-- Give ImGui a few frames to observe the initial hardware button-down.
	if rawMouseStateAvailable and os.clock() - physicalHoldStartedAt >= 0.05
		and not rawMouseDown then
		physicalMouseHeld = false
		return false
	end
	return true
end

local function startAutomaticFireLoop()
	if autoClickLoopRunning then
		return
	end
	autoClickLoopRunning = true
	task.spawn(function()
		local nextClickAt = os.clock() + getAutomaticFireInterval()
		while alive and options.AutomaticFire and isPhysicalMouseHeld() do
			local waitTime = nextClickAt - os.clock()
			if waitTime > 0 then
				task.wait(waitTime)
			end
			if not alive or not options.AutomaticFire
				or not isPhysicalMouseHeld() then
				break
			end

			local mousePosition = UserInputService:GetMouseLocation()
			sendingVirtualClick = true
			pcall(function()
				VirtualInputManager:SendMouseButtonEvent(
					mousePosition.X,
					mousePosition.Y,
					0,
					true,
					game,
					0
				)
			end)
			local clickInterval = getAutomaticFireInterval()
			local pressDuration = math.clamp(clickInterval * 0.2, 0.003, 0.02)
			task.wait(pressDuration)
			virtualReleasePending = true
			local released = pcall(function()
				VirtualInputManager:SendMouseButtonEvent(
					mousePosition.X,
					mousePosition.Y,
					0,
					false,
					game,
					0
				)
			end)
			if not released then
				virtualReleasePending = false
			end

			-- InputEnded from VirtualInputManager arrives just after a Heartbeat.
			-- Wait for that exact pending event, with a timeout for safety.
			local releaseDeadline = os.clock() + 0.12
			while virtualReleasePending and alive
				and os.clock() < releaseDeadline do
				RunService.Heartbeat:Wait()
			end
			virtualReleasePending = false
			sendingVirtualClick = false
			nextClickAt += clickInterval
			if nextClickAt < os.clock() then
				nextClickAt = os.clock()
			end
		end
		virtualReleasePending = false
		sendingVirtualClick = false
		autoClickLoopRunning = false
	end)
end

local function isMouseOverGunModerControl()
	local mousePosition = UserInputService:GetMouseLocation()
	local ok, guiObjects = pcall(function()
		return playerGui:GetGuiObjectsAtPosition(mousePosition.X, mousePosition.Y)
	end)
	if not ok then
		return false
	end
	for _, guiObject in ipairs(guiObjects) do
		if guiObject:IsA("GuiButton") or guiObject.Active then
			local owner = guiObject:FindFirstAncestorOfClass("ScreenGui")
			if owner and (owner.Name == "GunModerCompleteGui"
				or owner.Name == "GunModerSilentAimGui") then
				return true
			end
		end
	end
	return false
end

connect(playerMouse.Button1Down, function()
	if sendingVirtualClick or isMouseOverGunModerControl() then
		return
	end
	physicalMouseHeld = true
	physicalHoldStartedAt = os.clock()
	if options.AutomaticFire then
		startAutomaticFireLoop()
	end
end)

connect(playerMouse.Button1Up, function()
	if virtualReleasePending then
		virtualReleasePending = false
		return
	end
	if physicalMouseHeld then
		physicalMouseHeld = false
	end
end)

connect(UserInputService.WindowFocusReleased, function()
	physicalMouseHeld = false
	virtualReleasePending = false
end)

-- Advanced ESP uses regular Roblox UI objects; no Drawing library is needed.
local espEntries = {}

local function destroyEspEntry(targetPlayer)
	local entry = espEntries[targetPlayer]
	if not entry then
		return
	end
	if entry.Billboard then
		entry.Billboard:Destroy()
	end
	if entry.Tracer then
		entry.Tracer:Destroy()
	end
	espEntries[targetPlayer] = nil
end

local function clearEsp()
	local targets = {}
	for targetPlayer in pairs(espEntries) do
		table.insert(targets, targetPlayer)
	end
	for _, targetPlayer in ipairs(targets) do
		destroyEspEntry(targetPlayer)
	end
end

local function getWeaponToolName(targetPlayer)
	local function findIn(container)
		if not container then
			return nil
		end
		for _, object in ipairs(container:GetChildren()) do
			if object:IsA("Tool")
				and (object:FindFirstChild("Mag", true)
					or object:FindFirstChild("Ammo", true)) then
				return object.Name
			end
		end
		return nil
	end

	return findIn(targetPlayer.Character)
		or findIn(targetPlayer:FindFirstChild("Backpack"))
end

