local function decodeBase64(data)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	data = tostring(data or ""):gsub("[^" .. alphabet .. "=]", "")

	return (data:gsub(".", function(character)
		if character == "=" then
			return ""
		end

		local index = alphabet:find(character, 1, true)
		if not index then
			return ""
		end

		local value = index - 1
		local bits = ""
		for bitIndex = 6, 1, -1 do
			local enabled = value % (2 ^ bitIndex)
				- value % (2 ^ (bitIndex - 1)) > 0
			bits ..= enabled and "1" or "0"
		end
		return bits
	end):gsub("%d%d%d?%d?%d?%d?%d?%d?", function(bits)
		if #bits ~= 8 then
			return ""
		end

		local byte = 0
		for bitIndex = 1, 8 do
			if bits:sub(bitIndex, bitIndex) == "1" then
				byte += 2 ^ (8 - bitIndex)
			end
		end
		return string.char(byte)
	end))
end

local function ensureFolder(path)
	if type(makeFolderFunction) ~= "function" then
		return
	end

	local current = ""
	for part in path:gmatch("[^/]+") do
		current = current == "" and part or current .. "/" .. part
		local exists = false
		if type(isFolderFunction) == "function" then
			pcall(function()
				exists = isFolderFunction(current)
			end)
		end
		if not exists then
			pcall(makeFolderFunction, current)
		end
	end
end

local function fileExists(path)
	if type(isFileFunction) ~= "function" then
		return false
	end
	local ok, result = pcall(isFileFunction, path)
	return ok and result == true
end

local function loadSettings()
	if type(readFileFunction) ~= "function" or not fileExists(SETTINGS_FILE) then
		return
	end

	local okRead, contents = pcall(readFileFunction, SETTINGS_FILE)
	if not okRead or type(contents) ~= "string" then
		return
	end

	local okDecode, saved = pcall(HttpService.JSONDecode, HttpService, contents)
	if not okDecode or type(saved) ~= "table" then
		return
	end

	for id, defaultValue in pairs(DEFAULT_OPTIONS) do
		if typeof(saved[id]) == typeof(defaultValue) then
			options[id] = saved[id]
		end
	end
	hasRememberedOptions = true
end

loadSettings()

-- UserIds selected in FRIENDS are excluded from Silent Aim target selection.
-- They are stored as a comma-separated string so the existing JSON settings
-- system can remember the selection between executions.
local silentAimFriendIds = {}

local function rebuildSilentAimFriendIds()
	table.clear(silentAimFriendIds)
	for userId in tostring(options.SilentAimFriends or ""):gmatch("[^,]+") do
		silentAimFriendIds[userId] = true
	end
end

local function serializeSilentAimFriendIds()
	local userIds = {}
	for userId in pairs(silentAimFriendIds) do
		table.insert(userIds, userId)
	end
	table.sort(userIds)
	return table.concat(userIds, ",")
end

rebuildSilentAimFriendIds()

local saveVersion = 0
saveSettings = function(force)
	if type(writeFileFunction) ~= "function" then
		return
	end
	if not options.RememberSettings and not force then
		return
	end

	saveVersion += 1
	local requestedVersion = saveVersion
	task.delay(0.15, function()
		if not alive or requestedVersion ~= saveVersion then
			return
		end
		ensureFolder(ASSET_ROOT)
		local okEncode, encoded = pcall(HttpService.JSONEncode, HttpService, options)
		if okEncode then
			pcall(writeFileFunction, SETTINGS_FILE, encoded)
		end
	end)
end

local function renderOption(id)
	local bindings = optionBindings[id]
	if not bindings then
		return
	end
	for _, render in ipairs(bindings) do
		pcall(render, options[id])
	end
end

local function bindOption(id, render)
	optionBindings[id] = optionBindings[id] or {}
	table.insert(optionBindings[id], render)
	render(options[id])
end

local function assignOption(id, value)
	if options[id] == value then
		return false
	end
	options[id] = value
	renderOption(id)
	return true
end

local function setOption(id, value)
	if DEFAULT_OPTIONS[id] == nil then
		return
	end

	if id == "SilentAim" and value == true and options.NoSpread then
		assignOption("NoSpread", false)
	elseif id == "NoSpread" and value == true and options.SilentAim then
		assignOption("SilentAim", false)
		if setSilentAimActive then
			setSilentAimActive(false)
		end
	end

	local changed = assignOption(id, value)
	if not changed then
		return
	end

	if applyWeaponOptions then
		applyWeaponOptions()
	end
	if id == "SilentAim" and setSilentAimActive then
		setSilentAimActive(value == true)
	elseif id:sub(1, 9) == "SilentAim" and setSilentAimActive then
		setSilentAimActive(options.SilentAim == true, true)
	end
	if id:sub(1, 3) == "Esp" and updateEspState then
		updateEspState()
	end
	if updateGuiOptions then
		updateGuiOptions(id)
	end

	saveSettings(id == "RememberSettings")
end

local function loadTintableSprite()
	if type(writeFileFunction) ~= "function"
		or type(customAssetFunction) ~= "function" then
		return nil, "Brak writefile/getcustomasset. W Studio ustaw własny rbxassetid."
	end

	ensureFolder(ICON_FOLDER)
	if not fileExists(TINTABLE_SPRITE_FILE) then
		local bytes = decodeBase64(TINTABLE_SPRITE_BASE64)
		if bytes == "" then
			return nil, "Nie udało się zdekodować ikon."
		end
		local ok, err = pcall(writeFileFunction, TINTABLE_SPRITE_FILE, bytes)
		if not ok then
			return nil, tostring(err)
		end
	end

	local ok, asset = pcall(customAssetFunction, TINTABLE_SPRITE_FILE)
	if not ok or not asset or asset == "" then
		return nil, "Nie udało się załadować sprite ikon."
	end
	return asset
end

