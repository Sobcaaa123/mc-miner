local function createWeaponState(viewport, outlineOnly)
	local world = Instance.new("WorldModel")
	world.Parent = viewport

	local camera = Instance.new("Camera")
	camera.FieldOfView = BASE_CAMERA_FOV
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local display = Instance.new("Model")
	display.Name = outlineOnly and "OutlineModel" or "DisplayedWeapon"
	display.Parent = world

	local clone = weaponSource:Clone()
	clone.Parent = display

	for _, object in ipairs(display:GetDescendants()) do
		if object:IsA("BasePart") then
			object.Anchored = true
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			object.CastShadow = false
			if outlineOnly then
				object.Color = Color3.new(1, 1, 1)
				object.Material = Enum.Material.Neon
				object.Transparency = 0.25
				if object:IsA("MeshPart") then
					pcall(function()
						object.TextureID = ""
					end)
				end
			end
		end
	end

	local mag = display:FindFirstChild("Mag", true)
	local bolt = display:FindFirstChild("Bolt", true)
	if not bolt then
		bolt = display:FindFirstChild("Slide", true)
	end

	local sourcePivot = display:GetPivot()
	local magRelative
	local boltRelative
	if mag and mag:IsA("PVInstance") then
		magRelative = sourcePivot:ToObjectSpace(mag:GetPivot())
	end
	if bolt and bolt:IsA("PVInstance") then
		boltRelative = sourcePivot:ToObjectSpace(bolt:GetPivot())
	end

	display:PivotTo(CFrame.Angles(
		math.rad(WEAPON_X_ROTATION),
		math.rad(WEAPON_Y_ROTATION),
		0
	))

	return {
		Viewport = viewport,
		Camera = camera,
		Display = display,
		Mag = mag,
		Bolt = bolt,
		MagRelative = magRelative,
		BoltRelative = boltRelative,
		OutlineOnly = outlineOnly,
	}
end

