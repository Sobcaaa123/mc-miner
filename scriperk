local function stopSilentAim()
	silentState.active = false
	restoreSilentAimHook()
	clearSilentConnections()
	if silentState.gui then
		silentState.gui:Destroy()
	end
	silentState.gui = nil
	silentState.fovCircle = nil
	silentState.statusLabel = nil
	silentState.fovLabel = nil
	silentState.rangeLabel = nil
	silentState.targetPlayer = nil
	silentState.targetPart = nil
	silentState.lastHighlightedPlayer = nil
end

local function updateSilentAim()
	if not silentState.active then
		return
	end
	if not silentState.hooked and os.clock() - silentState.lastHookAttempt >= 0.75 then
		silentState.lastHookAttempt = os.clock()
		local hooked, hookError = attachSilentAimHook()
		if silentState.statusLabel and not hooked then
			silentState.statusLabel.Text = hookError or "Waiting for GunController"
		end
	end

	local targetPlayer, targetPart = findSilentTarget()
	silentState.targetPlayer = targetPlayer
	silentState.targetPart = targetPart
	if targetPlayer and targetPlayer ~= silentState.lastHighlightedPlayer then
		silentState.lastHighlightedPlayer = targetPlayer
		flashSilentTarget(targetPlayer)
	elseif not targetPlayer then
		silentState.lastHighlightedPlayer = nil
	end
	if silentState.statusLabel and silentState.hooked then
		silentState.statusLabel.Text = targetPlayer
			and ("Target: " .. targetPlayer.Name)
			or "No visible target inside FOV"
	end
end

setSilentAimActive = function(enabled, refreshOnly)
	if not enabled then
		if silentState.active then
			stopSilentAim()
		end
		return
	end
	if not silentState.active then
		silentState.active = true
		createSilentAimInterface()
		connectSilent(RunService.RenderStepped, updateSilentAim)
		updateSilentAim()
	elseif refreshOnly then
		updateSilentAimVisual()
	end
end

