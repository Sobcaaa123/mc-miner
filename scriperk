-- Weapon animation
local magAlpha = Instance.new("NumberValue")
magAlpha.Value = 0
magAlpha.Parent = screenGui

local boltAlpha = Instance.new("NumberValue")
boltAlpha.Value = 0
boltAlpha.Parent = screenGui

local zoomAlpha = Instance.new("NumberValue")
zoomAlpha.Value = 0
zoomAlpha.Parent = screenGui

local animationBusy = false
local elapsed = 0

local function tweenNumber(numberValue, value, duration, style, direction)
	local speed = math.max(options.AnimationSpeed / 100, 0.1)
	duration /= speed
	if options.SmoothTransitions == false then
		duration = 0
	end
	local animation = TweenService:Create(
		numberValue,
		TweenInfo.new(duration, style, direction),
		{ Value = value }
	)
	animation:Play()
	animation.Completed:Wait()
end

local function playSlide()
	if animationBusy or not alive then
		return
	end
	animationBusy = true

	task.spawn(function()
		tweenNumber(zoomAlpha, 1, 0.48, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tweenNumber(boltAlpha, 1, 0.62, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		task.wait(0.18 / math.max(options.AnimationSpeed / 100, 0.1))
		tweenNumber(boltAlpha, 0, 0.78, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		tweenNumber(zoomAlpha, 0, 0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		animationBusy = false
	end)
end

local function playShowMag()
	if animationBusy or not alive then
		return
	end
	animationBusy = true

	task.spawn(function()
		tweenNumber(zoomAlpha, 0.82, 0.42, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		tweenNumber(magAlpha, 1, 0.62, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
		task.wait(0.7 / math.max(options.AnimationSpeed / 100, 0.1))
		tweenNumber(magAlpha, 0, 0.58, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		tweenNumber(zoomAlpha, 0, 0.48, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		animationBusy = false
	end)
end

local renderConnection
renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not alive or not screenGui.Parent then
		if renderConnection then
			renderConnection:Disconnect()
		end
		return
	end

	elapsed += deltaTime
	local floating = math.sin(elapsed * 1.15) * 0.035
	local yaw = math.sin(elapsed * 0.55) * math.rad(4)
	local basePivot = CFrame.Angles(
		math.rad(WEAPON_X_ROTATION),
		math.rad(WEAPON_Y_ROTATION),
		0
	)
	local currentPivot = basePivot
		* CFrame.new(0, floating, 0)
		* CFrame.Angles(0, yaw, 0)

	for _, state in ipairs(weaponStates) do
		state.Display:PivotTo(currentPivot)

		if state.Mag and state.MagRelative then
			local back = MAG_BACK_OFFSET
				+ (SHOW_MAG_BACK_OFFSET - MAG_BACK_OFFSET) * magAlpha.Value
			local down = MAG_DOWN_OFFSET
				+ (SHOW_MAG_DOWN_OFFSET - MAG_DOWN_OFFSET) * magAlpha.Value
			state.Mag:PivotTo(
				currentPivot
					* CFrame.new(0, -down, back)
					* state.MagRelative
			)
		end

		if state.Bolt and state.BoltRelative then
			state.Bolt:PivotTo(
				currentPivot
					* CFrame.new(0, 0, BOLT_BACK_OFFSET * boltAlpha.Value)
					* state.BoltRelative
			)
		end
	end

	local fov = BASE_CAMERA_FOV
		+ (ZOOM_CAMERA_FOV - BASE_CAMERA_FOV) * zoomAlpha.Value
	weaponState.Camera.FieldOfView = fov
	outlineState.Camera.FieldOfView = fov - OUTLINE_FOV_DIFFERENCE
end)

