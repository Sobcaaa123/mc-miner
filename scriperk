local completeApi = {}

function completeApi:Get(optionId)
	return options[optionId]
end

function completeApi:Set(optionId, value)
	assert(DEFAULT_OPTIONS[optionId] ~= nil, "Unknown option: " .. tostring(optionId))
	setOption(optionId, value)
	return options[optionId]
end

function completeApi:RefreshWeapon()
	refreshCurrentWeapon()
	return gunPatchState.tool
end

function completeApi:Destroy()
	if not alive then
		return
	end
	alive = false
	physicalMouseHeld = false
	virtualReleasePending = false
	if rawMouseConnection then
		pcall(function()
			rawMouseConnection:Disconnect()
		end)
		rawMouseConnection = nil
	end
	stopSilentAim()
	clearEsp()
	restoreWeaponPatch()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)
	if screenGui.Parent then
		screenGui:Destroy()
	end
	if environment.GunModerCompleteAPI == self then
		environment.GunModerCompleteAPI = nil
	end
end

