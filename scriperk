	buttonLayout.Padding = UDim.new(0, 5)
	buttonLayout.SortOrder = Enum.SortOrder.LayoutOrder
	buttonLayout.Parent = playerButtons

	refreshSilentAimFriends = function()
		if not alive or not playerButtons.Parent then
			return
		end
		for _, child in ipairs(playerButtons:GetChildren()) do
			if child:IsA("GuiButton") or child.Name == "EmptyLabel" then
				child:Destroy()
			end
		end

		local serverPlayers = {}
		for _, targetPlayer in ipairs(Players:GetPlayers()) do
			if targetPlayer ~= player then
				table.insert(serverPlayers, targetPlayer)
			end
		end
		table.sort(serverPlayers, function(left, right)
			return string.lower(left.Name) < string.lower(right.Name)
		end)

		if #serverPlayers == 0 then
			local emptyLabel = Instance.new("TextLabel")
			emptyLabel.Name = "EmptyLabel"
			emptyLabel.Size = UDim2.new(1, 0, 0, 30)
			emptyLabel.BackgroundTransparency = 1
			emptyLabel.Font = Enum.Font.Gotham
			emptyLabel.Text = "No other players in the server."
			emptyLabel.TextColor3 = COLORS.Muted
			emptyLabel.TextSize = 9
			emptyLabel.ZIndex = 7
			emptyLabel.Parent = playerButtons
			return
		end

		for index, targetPlayer in ipairs(serverPlayers) do
			local userId = tostring(targetPlayer.UserId)
			local ignored = silentAimFriendIds[userId] == true
			local button = Instance.new("TextButton")
			button.Name = "Player_" .. userId
			button.Size = UDim2.new(1, 0, 0, 31)
			button.BackgroundColor3 = ignored and COLORS.AccentDark or COLORS.Control
			button.BorderSizePixel = 0
			button.AutoButtonColor = false
			button.Font = Enum.Font.GothamMedium
			button.Text = ignored and ("IGNORED  •  " .. targetPlayer.Name)
				or targetPlayer.Name
			button.TextColor3 = ignored and COLORS.Accent or COLORS.Text
			button.TextSize = 10
			button.TextTruncate = Enum.TextTruncate.AtEnd
			button.LayoutOrder = index
			button.ZIndex = 8
			button.Parent = playerButtons
			corner(button, 4)
			stroke(button, ignored and COLORS.AccentDark or COLORS.Stroke, 1, 0.15)

			button.MouseEnter:Connect(function()
				tween(button, 0.14, {
					BackgroundColor3 = ignored and COLORS.AccentDark or COLORS.PanelHover,
					TextColor3 = COLORS.Accent,
				})
			end)
			button.MouseLeave:Connect(function()
				tween(button, 0.14, {
					BackgroundColor3 = ignored and COLORS.AccentDark or COLORS.Control,
					TextColor3 = ignored and COLORS.Accent or COLORS.Text,
				})
			end)
			button.MouseButton1Click:Connect(function()
				if silentAimFriendIds[userId] then
					silentAimFriendIds[userId] = nil
				else
					silentAimFriendIds[userId] = true
				end
				setOption("SilentAimFriends", serializeSilentAimFriendIds())
				refreshSilentAimFriends()
			end)
		end
	end

	refreshSilentAimFriends()
	connect(Players.PlayerAdded, function()
		task.defer(refreshSilentAimFriends)
	end)
	connect(Players.PlayerRemoving, function()
		task.defer(refreshSilentAimFriends)
	end)
end

