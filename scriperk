local function selectPage(selectedIndex)
	for index, page in ipairs(pages) do
		local selected = index == selectedIndex
		local tab = tabButtons[index]
		page.Visible = selected
		if selected then
			page.CanvasPosition = Vector2.zero
			tween(tab.Button, 0.2, { BackgroundTransparency = 0.2 })
			tween(tab.Label, 0.2, { TextColor3 = COLORS.Text })
			tween(tab.Icon, 0.2, {
				ImageColor3 = COLORS.Accent,
				ImageTransparency = 0,
			})
			tween(tab.Edge, 0.22, { Size = UDim2.fromOffset(2, 22) })
		else
			tween(tab.Button, 0.2, { BackgroundTransparency = 1 })
			tween(tab.Label, 0.2, { TextColor3 = COLORS.Muted })
			tween(tab.Icon, 0.2, {
				ImageColor3 = COLORS.Accent,
				ImageTransparency = 0.38,
			})
			tween(tab.Edge, 0.2, { Size = UDim2.fromOffset(2, 0) })
		end
	end
end

