updateEspState = function()
	if not options.EspEnabled then
		clearEsp()
	end
end

local function updateEsp()
	if not options.EspEnabled then
		return
	end

	local camera = workspace.CurrentCamera
	if not camera then
		return
	end

	local cameraPosition = camera.CFrame.Position
	local screenBottom = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y - 8)
	local livePlayers = {}

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player then
			livePlayers[targetPlayer] = true
			local character = targetPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local head = character and character:FindFirstChild("Head")
			root = root or head
			local adornee = head or root
			local entry = espEntries[targetPlayer] or createEspEntry(targetPlayer)

			if humanoid and humanoid.Health > 0 and root and adornee then
				local distance = (root.Position - cameraPosition).Magnitude
				local worldOffset = head and Vector3.new(0, 1, 0)
					or Vector3.new(0, 3.5, 0)
				local espWorldPosition = adornee.Position + worldOffset
				local screenPoint, onScreen = camera:WorldToViewportPoint(espWorldPosition)
				local inRange = distance <= options.EspRange
				entry.Billboard.Adornee = adornee
				entry.Billboard.SizeOffset = Vector2.new(0, 0.5)
				entry.Billboard.StudsOffset = Vector3.zero
				entry.Billboard.StudsOffsetWorldSpace = worldOffset
				entry.Billboard.MaxDistance = options.EspRange
				entry.Billboard.Enabled = inRange

			local lines = { targetPlayer.DisplayName }
			if options.EspPosition then
					table.insert(lines, string.format(
						"[%.0f studs]  X %.0f  Y %.0f  Z %.0f",
						distance,
						root.Position.X,
						root.Position.Y,
						root.Position.Z
					))
				end
				local toolName = options.EspTool and getWeaponToolName(targetPlayer) or nil
				entry.ToolLabel.Text = toolName or ""
				entry.ToolLabel.Visible = toolName ~= nil
				entry.Label.Text = table.concat(lines, "\n")

			local healthAlpha = humanoid.MaxHealth > 0
				and math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) or 0
			entry.HealthBar.Visible = options.EspHealth
			entry.HealthFill.Size = UDim2.fromScale(1, healthAlpha)
			entry.HealthFill.BackgroundColor3 = Color3.fromRGB(
				math.floor(255 * (1 - healthAlpha)),
				math.floor(70 + 185 * healthAlpha),
				55
			)
			entry.Label.TextColor3 = COLORS.Text

				entry.Tracer.Visible = options.EspTracers and inRange
					and onScreen and screenPoint.Z > 0
				if entry.Tracer.Visible then
					local targetPoint = Vector2.new(screenPoint.X, screenPoint.Y)
					local difference = targetPoint - screenBottom
					entry.Tracer.Position = UDim2.fromOffset(
						(screenBottom.X + targetPoint.X) * 0.5,
						(screenBottom.Y + targetPoint.Y) * 0.5
					)
					entry.Tracer.Size = UDim2.fromOffset(difference.Magnitude, 1)
					entry.Tracer.Rotation = math.deg(math.atan2(difference.Y, difference.X))
				end
		else
			entry.Billboard.Enabled = false
			entry.HealthBar.Visible = false
			entry.ToolLabel.Visible = false
				entry.Tracer.Visible = false
			end
		end
	end

	local stalePlayers = {}
	for targetPlayer in pairs(espEntries) do
		if not livePlayers[targetPlayer] or not targetPlayer.Parent then
			table.insert(stalePlayers, targetPlayer)
		end
	end
	for _, targetPlayer in ipairs(stalePlayers) do
		destroyEspEntry(targetPlayer)
	end
end

connect(RunService.RenderStepped, updateEsp)

-- Built-in Silent Aim. The small panel exists only while the main option is on.
local silentState = {
	active = false,
	gui = nil,
	fovCircle = nil,
	statusLabel = nil,
	fovLabel = nil,
	rangeLabel = nil,
	panelPosition = nil,
	targetPlayer = nil,
	targetPart = nil,
	lastHighlightedPlayer = nil,
	connections = {},
	functionEnvironment = nil,
	originalGet3DPosition = nil,
	hookedGet3DPosition = nil,
	hooked = false,
	lastHookAttempt = 0,
}

local function connectSilent(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(silentState.connections, connection)
	return connection
end

local function clearSilentConnections()
	for _, connection in ipairs(silentState.connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(silentState.connections)
end

local function flashSilentTarget(targetPlayer)
	local character = targetPlayer and targetPlayer.Character
	if not character then
		return
	end
	local highlight = Instance.new("Highlight")
	highlight.Name = "SilentAimTargetFlash"
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillColor = COLORS.Accent
	highlight.FillTransparency = 0.55
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.OutlineTransparency = 0
	highlight.Parent = character
	task.delay(0.4, function()
		if highlight.Parent then
			highlight:Destroy()
		end
	end)
end

local function isSilentTargetVisible(character, targetPart)
	local camera = workspace.CurrentCamera
	if not camera then
		return false
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = player.Character and { player.Character } or {}
	params.IgnoreWater = true
	local origin = camera.CFrame.Position
	local result = workspace:Raycast(origin, targetPart.Position - origin, params)
	return result == nil or result.Instance:IsDescendantOf(character)
end

local function findSilentTarget()
	if not silentState.active then
		return nil, nil
	end
	local camera = workspace.CurrentCamera
	if not camera then
		return nil, nil
	end

	local center = camera.ViewportSize * 0.5
	local cameraPosition = camera.CFrame.Position
	local closestPixels = options.SilentAimFov
	local closestPlayer
	local closestPart

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		if targetPlayer ~= player
			and not silentAimFriendIds[tostring(targetPlayer.UserId)] then
			local character = targetPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local targetPart = character and (character:FindFirstChild("Head")
				or character:FindFirstChild("HumanoidRootPart"))
			if humanoid and humanoid.Health > 0 and targetPart
				and (targetPart.Position - cameraPosition).Magnitude <= options.SilentAimRange then
				local screenPosition, onScreen = camera:WorldToViewportPoint(targetPart.Position)
				if onScreen and screenPosition.Z > 0 then
					local pixels = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude
					if pixels <= closestPixels and isSilentTargetVisible(character, targetPart) then
						closestPixels = pixels
						closestPlayer = targetPlayer
						closestPart = targetPart
					end
				end
			end
		end
	end
	return closestPlayer, closestPart
end

local function attachSilentAimHook()
	if silentState.hooked then
		return true
	end
	local controllerScript = findControllerModule()
	if not controllerScript then
		return false, "Waiting for GunController"
	end
	local okRequire, controllerModule = pcall(require, controllerScript)
	if not okRequire or type(controllerModule) ~= "table"
		or type(controllerModule.Shoot) ~= "function" then
		return false, "GunController.Shoot unavailable"
	end
	if type(getfenv) ~= "function" then
		return false, "getfenv unavailable"
	end
	local okEnvironment, functionEnvironment = pcall(getfenv, controllerModule.Shoot)
	if not okEnvironment or type(functionEnvironment) ~= "table"
		or type(functionEnvironment.Get3DPosition) ~= "function" then
		return false, "Get3DPosition unavailable"
	end

	local originalGet3DPosition = functionEnvironment.Get3DPosition
	local hookedGet3DPosition
	hookedGet3DPosition = function(screenPoint, gun)
		local targetPart = silentState.targetPart
		if silentState.active and targetPart and targetPart.Parent then
			return targetPart.Position
		end
		return originalGet3DPosition(screenPoint, gun)
	end

	silentState.functionEnvironment = functionEnvironment
	silentState.originalGet3DPosition = originalGet3DPosition
	silentState.hookedGet3DPosition = hookedGet3DPosition
	functionEnvironment.Get3DPosition = hookedGet3DPosition
	silentState.hooked = functionEnvironment.Get3DPosition == hookedGet3DPosition
	return silentState.hooked,
		silentState.hooked and nil or "Get3DPosition replacement rejected"
end

local function restoreSilentAimHook()
	if silentState.functionEnvironment
		and silentState.functionEnvironment.Get3DPosition == silentState.hookedGet3DPosition then
		silentState.functionEnvironment.Get3DPosition = silentState.originalGet3DPosition
	end
	silentState.functionEnvironment = nil
	silentState.originalGet3DPosition = nil
	silentState.hookedGet3DPosition = nil
	silentState.hooked = false
end

local function updateSilentAimVisual()
	if not silentState.gui then
		return
	end
	if silentState.fovCircle then
		silentState.fovCircle.Size = UDim2.fromOffset(
			options.SilentAimFov * 2,
			options.SilentAimFov * 2
		)
	end
	if silentState.fovLabel then
		silentState.fovLabel.Text = "FOV: " .. options.SilentAimFov .. " px"
	end
	if silentState.rangeLabel then
		silentState.rangeLabel.Text = "RANGE: " .. options.SilentAimRange .. " studs"
	end
end

