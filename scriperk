local gunPatchState = {
	controllerModule = nil,
	gun = nil,
	tool = nil,
	originalModule = nil,
	patchedModule = nil,
}

local syncedInitialWeapon = hasRememberedOptions

local function cloneTable(source)
	if table.clone then
		return table.clone(source)
	end
	local result = {}
	for key, value in pairs(source) do
		result[key] = value
	end
	return result
end

local function getCharacter()
	local character = player.Character
	if character and character.Parent then
		return character
	end
	local characters = workspace:FindFirstChild("Characters")
	return characters and characters:FindFirstChild(player.Name) or nil
end

local function findEquippedTool()
	local character = getCharacter()
	if not character then
		return nil
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			return child
		end
	end
	return nil
end

local function findControllerModule()
	if gunPatchState.controllerModule and gunPatchState.controllerModule.Parent then
		return gunPatchState.controllerModule
	end
	local playerScripts = player:FindFirstChild("PlayerScripts")
	if not playerScripts then
		return nil
	end
	for _, object in ipairs(playerScripts:GetDescendants()) do
		if object:IsA("ModuleScript") and object.Name == "GunController" then
			gunPatchState.controllerModule = object
			return object
		end
	end
	return nil
end

local function resolveCurrentGun()
	local controllerScript = findControllerModule()
	if not controllerScript then
		return nil, nil
	end
	local ok, gunController = pcall(require, controllerScript)
	if not ok or type(gunController) ~= "table" then
		return nil, nil
	end
	local controller = gunController.Controller
	local equippedTool = findEquippedTool()
	if not controller or not equippedTool then
		return nil, nil
	end
	local gun = controller.CurrentGun
	if gun and gun.ToolInstance == equippedTool then
		return gun, equippedTool
	end
	if type(controller.GunTables) == "table" then
		gun = controller.GunTables[equippedTool]
		if gun and gun.ToolInstance == equippedTool then
			return gun, equippedTool
		end
	end
	return nil, nil
end

local function restoreWeaponPatch()
	local gun = gunPatchState.gun
	if gun and gunPatchState.originalModule
		and gun.Module == gunPatchState.patchedModule then
		pcall(function()
			gun.Module = gunPatchState.originalModule
		end)
	end
	gunPatchState.gun = nil
	gunPatchState.tool = nil
	gunPatchState.originalModule = nil
	gunPatchState.patchedModule = nil
end

local function originalValue(original, key, fallback)
	local value = original and original[key]
	if value == nil then
		return fallback
	end
	return value
end

local function applyOptionsToModule(module, original)
	module.FireRate = options.FireInterval
	module.BurstFireEnabled = options.BurstFireEnabled
	module.BulletPerBurst = math.floor(options.RoundsPerBurst + 0.5)
	module.BurstRate = options.BurstInterval
	module.ShotgunEnabled = options.MultiProjectileEnabled
	module.BulletPerShot = math.floor(options.ProjectilesPerShot + 0.5)

	if options.NoRecoil then
		module.CameraRecoilingEnabled = false
		module.Recoil = 0
		module.AngleX_Min = 0
		module.AngleX_Max = 0
		module.AngleY_Min = 0
		module.AngleY_Max = 0
		module.AngleZ_Min = 0
		module.AngleZ_Max = 0
	else
		module.CameraRecoilingEnabled = originalValue(original, "CameraRecoilingEnabled", true)
		module.Recoil = originalValue(original, "Recoil", 50)
		module.AngleX_Min = originalValue(original, "AngleX_Min", 1.8)
		module.AngleX_Max = originalValue(original, "AngleX_Max", 2.5)
		module.AngleY_Min = originalValue(original, "AngleY_Min", -0.5)
		module.AngleY_Max = originalValue(original, "AngleY_Max", 0.5)
		module.AngleZ_Min = originalValue(original, "AngleZ_Min", -1)
		module.AngleZ_Max = originalValue(original, "AngleZ_Max", 2)
	end
	module.SpreadX = options.NoSpread and 0 or originalValue(original, "SpreadX", 5)
	module.SpreadY = options.NoSpread and 0 or originalValue(original, "SpreadY", 5)
	module.JamChance = options.NoJam and -1 or originalValue(original, "JamChance", 1)
end

applyWeaponOptions = function()
	if gunPatchState.patchedModule and gunPatchState.originalModule then
		applyOptionsToModule(gunPatchState.patchedModule, gunPatchState.originalModule)
	end
end

local function syncInitialOptions(module)
	if syncedInitialWeapon or type(module) ~= "table" then
		return
	end
	syncedInitialWeapon = true
	assignOption("FireInterval", tonumber(module.FireRate) or DEFAULT_OPTIONS.FireInterval)
	assignOption("BurstFireEnabled", module.BurstFireEnabled == true)
	assignOption("RoundsPerBurst", tonumber(module.BulletPerBurst) or DEFAULT_OPTIONS.RoundsPerBurst)
	assignOption("BurstInterval", tonumber(module.BurstRate) or DEFAULT_OPTIONS.BurstInterval)
	assignOption("MultiProjectileEnabled", module.ShotgunEnabled == true)
	assignOption("ProjectilesPerShot", tonumber(module.BulletPerShot) or DEFAULT_OPTIONS.ProjectilesPerShot)
end

local function refreshCurrentWeapon()
	local gun, tool = resolveCurrentGun()
	if not gun or type(gun.Module) ~= "table" then
		if gunPatchState.gun then
			restoreWeaponPatch()
		end
		footer.Text = "AUTO-DETECT  |  EQUIP A WEAPON"
		footer.TextColor3 = Color3.fromRGB(64, 67, 76)
		return
	end

	if gunPatchState.gun == gun and gunPatchState.tool == tool
		and gun.Module == gunPatchState.patchedModule then
		return
	end

	restoreWeaponPatch()
	gunPatchState.gun = gun
	gunPatchState.tool = tool
	gunPatchState.originalModule = gun.Module
	syncInitialOptions(gun.Module)
	gunPatchState.patchedModule = cloneTable(gun.Module)
	applyOptionsToModule(gunPatchState.patchedModule, gunPatchState.originalModule)
	local ok = pcall(function()
		gun.Module = gunPatchState.patchedModule
	end)
	if not ok then
		restoreWeaponPatch()
		footer.Text = "AUTO-DETECT  |  PATCH FAILED"
		footer.TextColor3 = COLORS.Danger
		return
	end
	footer.Text = "AUTO-DETECT  |  " .. tool.Name
	footer.TextColor3 = COLORS.Accent
end

